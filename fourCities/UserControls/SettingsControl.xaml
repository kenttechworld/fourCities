<UserControl x:Class="fourCities.UserControls.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:fourCities.UserControls"
             xmlns:viewModels="clr-namespace:fourCities.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="200">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0">
            <StackPanel Orientation="Vertical">
                <Label Content="Set Clock Size" FontSize="20"/>
                <TextBox />
                <Button Content="Set" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
