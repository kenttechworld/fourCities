<UserControl x:Class="fourCities.UserControls.HometownControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:fourCities.UserControls"
             xmlns:viewModels="clr-namespace:fourCities.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="🛖" Style="{StaticResource HomeButton}" Command="{Binding OpenSettingsWindowCommand}"/> 
            <Label Content="Home time" Foreground="Azure" FontSize="{Binding LabelSize}" VerticalContentAlignment="Center"/>
            
        </StackPanel>
        <Label Grid.Row="1" Content="{Binding CurrentTime}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{Binding ClockSize}"/>

    </Grid>
</UserControl>
